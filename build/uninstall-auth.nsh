; build/uninstall-auth.nsh — حماية إلغاء التثبيت بكلمة سر حساب المدير (v2.6.0)
; ============================================================================
; هذا الملف يُضمَّل في رأس NSIS المشترك (nsis.include) فيُدرَج في كل من
; المثبّت والمزيل، لكن الماكرو لا تُعرَّف إلا في بناء المزيل (BUILD_UNINSTALLER).
;
; آلية العمل:
;   مزيل التطبيق (الذي يُستدعى من إعدادات ويندوز / لوحة التحكم / التشغيل المباشر)
;   يُشغّل تنفيذية التطبيق مع العلم --uninstall-auth قبل حذف أي ملف. التطبيق
;   يعرض نافذة عربية تطلب الرقم السري لحساب المسؤول ويتحقق منه بنفس دالة
;   تسجيل الدخول (crypto.scrypt + timingSafeEqual) من نفس تجزئة حساب المدير
;   المخزّنة في قاعدة البيانات. رمز الخروج هو قرار التفويض الوحيد:
;     0   = كلمة سر صحيحة → يكمل المزيل الحذف
;     ≠0  = رفض/إلغاء/خطأ → Abort قبل لمس أي ملف (تبقى التثبيتات والبيانات)
;
;   لا توجد أي كلمة سر أو تجزئة أو سر مضمّن هنا إطلاقًا — كل التحقق في التطبيق.
;
;   استثناء واحد مقصود: مسار التحديث التلقائي. المُحدِّث الجديد يُشغّل المزيل
;   القديم مع العلم --updated (أنظر installUtil.nsh). التحديث ليس إلغاء تثبيت
;   (ولا تحذف معه البيانات أصلًا)، فلو طلبنا كلمة السر هناك لتعطّلت التحديثات.
; ============================================================================

!ifdef BUILD_UNINSTALLER

Var /GLOBAL unauthExitCode

!macro customUnInstall
  ; (1) مسار التحديث التلقائي: لا نطلب كلمة السر (التحديث ليس حذفًا للبرنامج).
  ;     ملاحظة مهمة: لا يجوز استخدام Return هنا! Return داخل القسم (Section)
  ;     يُنهي القسم بالكامل فلا يُحذف أي ملف ولا تُنظّف السجل. لذلك نحيط منطق
  ;     المصادقة بـ ${ifNot} ${isUpdated} فقط، وبذلك يكمل المزيل خطوات الحذف
  ;     الطبيعية بعد تجاوز المصادقة.
  ${ifNot} ${isUpdated}

    ; (2) لا يمكن التحقق بدون تنفيذية التطبيق → فشل مُغلق مع توضيح سبب الرفض
    ;     وطريقة الاستعادة (إعادة تثبيت نفس النسخة تُصلح الملفات الناقصة).
    ${ifnot} ${FileExists} "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
      MessageBox MB_OK|MB_ICONEXCLAMATION "تعذّر التحقق من إذن حذف البرنامج لأن ملفاته غير مكتملة.$\r$\n$\r$\nللحذف: أعد تثبيت نفس النسخة لإصلاح الملفات الناقصة، ثم أعد المحاولة."
      Abort
    ${endif}

    ; (3) تشغيل التطبيق في وضع مصادقة إلغاء التثبيت والانتظار لقرار المستخدم
    DetailPrint "جاري التحقق من إذن حذف البرنامج..."
    ClearErrors
    ExecWait '"$INSTDIR\${APP_EXECUTABLE_FILENAME}" --uninstall-auth' $unauthExitCode

    ; (4) أي نتيجة غير النجاح = رفض الحذف (كلمة سر خاطئة / إلغاء / خطأ تشغيل)
    ${if} ${errors}
    ${orIf} $unauthExitCode != 0
      MessageBox MB_OK|MB_ICONEXCLAMATION "تم رفض حذف البرنامج.$\r$\n$\r$\nالرقم السري غير صحيح أو تم إلغاء العملية. لم يتم حذف أي شيء."
      Abort
    ${endif}

  ${endIf}
!macroend

!endif
